<Window x:Class="WinWid.Clock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinWid"
        mc:Ignorable="d"
        Title="Clock" Height="450" SizeToContent="Width"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        BorderThickness="0">
    
    <Window.Resources>
        
        <Style x:Key="TStyle" TargetType="TextBlock">
            
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource LexendDeca}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="70"/>
        </Style>
    </Window.Resources>
    
    <Grid 
        Background="Transparent">
        
        <StackPanel
            HorizontalAlignment="Center">
            
            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Center">
                
                <TextBlock x:Name="T0" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T1" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T2" Style="{StaticResource TStyle}" Text=":"/>
                <TextBlock x:Name="T3" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T4" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T5" Style="{StaticResource TStyle}" Text=":"/>
                <TextBlock x:Name="T6" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T7" Style="{StaticResource TStyle}" Text="0"/>
                <TextBlock x:Name="T8" Style="{StaticResource TStyle}" Text=" "/>
                <TextBlock x:Name="T9" Style="{StaticResource TStyle}" Text="A"/>
                <TextBlock x:Name="T10" Style="{StaticResource TStyle}" Text="M"/>
            </StackPanel>

            <TextBlock
                x:Name="Date"
                Background="Transparent"
                FontSize="50"
                Text="1. January 2025"
                Foreground="White"
                TextAlignment="Center"
                FontFamily="{StaticResource LexendDeca}"
                FontWeight="Medium"
                Typography.NumeralStyle="Normal"/>
        </StackPanel>
    </Grid>
</Window>
