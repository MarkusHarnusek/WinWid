<Window x:Class="WinWid.SystemMonitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinWid"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts"
        mc:Ignorable="d"
        Title="Clock" Height="450" Width="800"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        BorderThickness="0">

    <Window.Resources>
        <Style x:Key="TStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource LexendDeca}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="70"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CPU Usage Chart -->
        <Border Grid.Row="0" Grid.Column="0" Background="#20000000" 
                BorderBrush="#40FFFFFF" BorderThickness="1" 
                CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="CPU Usage" Grid.Row="0" 
                          Foreground="White" FontSize="16" 
                          FontWeight="SemiBold" Margin="10,5"/>
                
                <lvc:CartesianChart Grid.Row="1" x:Name="CpuChart" 
                                   Margin="5" Background="Transparent">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis ShowLabels="False">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="0"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0" MaxValue="100" 
                                 Foreground="White">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#40FFFFFF" StrokeThickness="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Memory Usage Chart -->
        <Border Grid.Row="0" Grid.Column="1" Background="#20000000" 
                BorderBrush="#40FFFFFF" BorderThickness="1" 
                CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Memory Usage" Grid.Row="0" 
                          Foreground="White" FontSize="16" 
                          FontWeight="SemiBold" Margin="10,5"/>
                
                <lvc:CartesianChart Grid.Row="1" x:Name="MemoryChart" 
                                   Margin="5" Background="Transparent">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis ShowLabels="False">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="0"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0" MaxValue="100" 
                                 Foreground="White">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#40FFFFFF" StrokeThickness="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Network Usage Chart -->
        <Border Grid.Row="1" Grid.Column="0" Background="#20000000" 
                BorderBrush="#40FFFFFF" BorderThickness="1" 
                CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Network Usage" Grid.Row="0" 
                          Foreground="White" FontSize="16" 
                          FontWeight="SemiBold" Margin="10,5"/>
                
                <lvc:CartesianChart Grid.Row="1" x:Name="NetworkChart" 
                                   Margin="5" Background="Transparent">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis ShowLabels="False">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="0"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0" 
                                 Foreground="White">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#40FFFFFF" StrokeThickness="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Disk Usage Chart -->
        <Border Grid.Row="1" Grid.Column="1" Background="#20000000" 
                BorderBrush="#40FFFFFF" BorderThickness="1" 
                CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Disk Usage" Grid.Row="0" 
                          Foreground="White" FontSize="16" 
                          FontWeight="SemiBold" Margin="10,5"/>
                
                <lvc:CartesianChart Grid.Row="1" x:Name="DiskChart" 
                                   Margin="5" Background="Transparent">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis ShowLabels="False">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="0"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0" 
                                 Foreground="White">
                            <lvc:Axis.Separator>
                                <lvc:Separator Stroke="#40FFFFFF" StrokeThickness="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Border>
    </Grid>
</Window>
