<Window x:Class="WinWid.SystemMonitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinWid"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Clock" Height="450" Width="800"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="False"
        BorderThickness="0">

    <Window.Resources>
        <Style x:Key="TStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource LexendDeca}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="70"/>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CPU Usage Chart -->
        <Border Grid.Row="0" Grid.Column="0" Background="#CC000000" CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CPU Usage" Foreground="White" FontSize="16" 
                           FontWeight="SemiBold" Margin="10,5" HorizontalAlignment="Center"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding CpuSeries}" 
                                     LegendLocation="None" Margin="5">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="%" MinValue="0" MaxValue="100" Foreground="White"/>
                    </lvc:CartesianChart.AxisY>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Labels}" Foreground="White"/>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Memory Usage Chart -->
        <Border Grid.Row="0" Grid.Column="1" Background="#CC000000" CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Memory Usage" Foreground="White" FontSize="16" 
                           FontWeight="SemiBold" Margin="10,5" HorizontalAlignment="Center"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding MemorySeries}" 
                                     LegendLocation="None" Margin="5">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="%" MinValue="0" MaxValue="100" Foreground="White"/>
                    </lvc:CartesianChart.AxisY>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Labels}" Foreground="White"/>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Network Usage Chart -->
        <Border Grid.Row="1" Grid.Column="0" Background="#CC000000" CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Network Usage" Foreground="White" FontSize="16" 
                           FontWeight="SemiBold" Margin="10,5" HorizontalAlignment="Center"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding NetworkSeries}" 
                                     LegendLocation="None" Margin="5">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="MB/s" MinValue="0" Foreground="White"/>
                    </lvc:CartesianChart.AxisY>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Labels}" Foreground="White"/>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>

        <!-- Disk Usage Chart -->
        <Border Grid.Row="1" Grid.Column="1" Background="#CC000000" CornerRadius="8" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Disk Usage" Foreground="White" FontSize="16" 
                           FontWeight="SemiBold" Margin="10,5" HorizontalAlignment="Center"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding DiskSeries}" 
                                     LegendLocation="None" Margin="5">
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="%" MinValue="0" MaxValue="100" Foreground="White"/>
                    </lvc:CartesianChart.AxisY>
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding Labels}" Foreground="White"/>
                    </lvc:CartesianChart.AxisX>
                </lvc:CartesianChart>
            </Grid>
        </Border>
    </Grid>
</Window>
