<Application x:Class="WinWid.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinWid"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="LexendDeca">pack://application:,,,/Assetts/Fonts/Lexend_Deca,Montserrat,Roboto/Lexend_Deca/#Lexend Deca</FontFamily>
        <FontFamily x:Key="Montserrat">pack://application:,,,/Assetts/Fonts/Lexend_Deca,Montserrat,Roboto/Montserrat/#Montserrat</FontFamily>
        <FontFamily x:Key="Roboto">pack://application:,,,/Assetts/Fonts/Lexend_Deca,Montserrat,Roboto/Roboto/#Roboto</FontFamily>
    </Application.Resources>
</Application>
