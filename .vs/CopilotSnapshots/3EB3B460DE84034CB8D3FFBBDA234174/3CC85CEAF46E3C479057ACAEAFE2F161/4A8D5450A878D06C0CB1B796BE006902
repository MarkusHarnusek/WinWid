using System.IO;
using System.Windows;

namespace WinWid.Config
{
    class ClockConfig
    {
        public int WidthRatio { get; set; } = 3;
        public int HeightRatio { get; set; } = 3;
        public int TopOffsetRatio { get; set; } = 20;
        public bool Use24H { get; set; } = true;
        public bool ShowSeconds { get; set; } = true;
        public bool ShowDate { get; set; } = true;

        public ClockConfig()
        {
            Load();
        }

        public void Load()
        {

        }

        public void Save()
        {
            string json = System.Text.Json.JsonSerializer.Serialize(this, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });

            string configPath = Path.Combine("config", "clock_config.json");
            string directory = Path.GetDirectoryName(configPath)!;
            MessageBox.Show(directory);

            if (!Directory.Exists(directory))
            {
                Directory.CreateDirectory(directory);
            }

            File.WriteAllText(configPath, json);
        }
    }
}
