using LiveCharts.Wpf;
using System.Runtime.InteropServices;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Interop;
using System.Windows.Threading;

namespace WinWid
{
    /// <summary>
    /// Interaction logic for SystemMonitor.xaml
    /// </summary>
    public partial class SystemMonitor : Window
    {
        private double lastHeight;
        private double lastWidth;

        private Config.SystemMonitorConfig config;
        private DispatcherTimer timer;

        List<Border> chartBorders = new List<Border>();
        List<CartesianChart> charts = new List<CartesianChart>();

        private const int GWL_EXSTYLE = -20;
        private const int WS_EX_TOOLWINDOW = 0x00000080;
        private const int GWLP_HWNDPARENT = -8;

        [DllImport("user32.dll")]
        private static extern int GetWindowLong(IntPtr hWnd, int nIndex);

        [DllImport("user32.dll")]
        private static extern int SetWindowLong(IntPtr hWnd, int nIndex, int dwNewLong);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern IntPtr SetWindowLongPtr(IntPtr hWnd, int nIndex, IntPtr dwNewLong);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern IntPtr FindWindow(string? lpClassName, string? lpWindowName);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern IntPtr FindWindowEx(IntPtr hwndParent, IntPtr hwndChildAfter, string lpszClass, string? lpszWindow);

        [DllImport("user32.dll")]
        private static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int X, int Y, int cx, int cy, uint uFlags);

        private static readonly IntPtr HWND_BOTTOM = new IntPtr(1);
        private static readonly IntPtr HWND_NOTOPMOST = new IntPtr(-2);
        private const uint SWP_NOSIZE = 0x0001;
        private const uint SWP_NOMOVE = 0x0002;
        private const uint SWP_NOACTIVATE = 0x0010;

#pragma warning disable CS8618
        public SystemMonitor(Config.SystemMonitorConfig config)
#pragma warning restore CS8618
        {
            this.config = config;
            InitializeComponent();
            //TransformToPos();
            SourceInitialized += Clock_SourceInitialized;
            Loaded += Clock_Loaded;
            InitializeTimer();

            chartBorders = [CpuChartBorder, MemChartBorder, NetChartBorder, DiskChartBorder];
            charts = [CpuChart, MemChart, NetChart, DiskChart];

            SetUpItems();
        }

        /// <summary>
        /// Sets up all of the items according to the config
        /// </summary>
        public void SetUpItems()
        {

        }

        /// <summary>
        /// Hides the window from the Alt-Tab switcher and pins it above the desktop
        /// </summary>
        private void Clock_SourceInitialized(object? sender, EventArgs e)
        {
            var helper = new WindowInteropHelper(this);

            // Hide from Alt-Tab
            int exStyle = GetWindowLong(helper.Handle, GWL_EXSTYLE);
            SetWindowLong(helper.Handle, GWL_EXSTYLE, exStyle | WS_EX_TOOLWINDOW);

            // Pin to desktop layer (above desktop, immune to Win+D)
            IntPtr desktopHandle = GetDesktopWorkerW();
            if (desktopHandle != IntPtr.Zero)
            {
                SetWindowLongPtr(helper.Handle, GWLP_HWNDPARENT, desktopHandle);
            }
        }

        /// <summary>
        /// Positions the window at the bottom of the z-order
        /// </summary>
        private void Clock_Loaded(object? sender, RoutedEventArgs e)
        {
            var helper = new WindowInteropHelper(this);
            SetWindowPos(helper.Handle, HWND_BOTTOM, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);

            // Use Dispatcher to ensure layout is complete before positioning
            Dispatcher.BeginInvoke(new Action(() =>
            {
                TransformToPos();
            }), System.Windows.Threading.DispatcherPriority.Loaded);
        }

        /// <summary>
        /// Initializes the timer that updates the clock periodically
        /// </summary>
        private void InitializeTimer()
        {
            timer = new DispatcherTimer();
            timer.Interval = TimeSpan.FromSeconds(1); // Update every second
            timer.Tick += Timer_Tick;
            timer.Start();
        }

        /// <summary>
        /// Called periodically by the timer
        /// </summary>
        private void Timer_Tick(object? sender, EventArgs e)
        {
            (double currentWidth, double currentHeight) = GetCurrentScreenDimensions();

            if (lastHeight != currentHeight || lastWidth != currentWidth)
            {
                TransformToPos();
            }

            lastHeight = currentHeight;
            lastWidth = currentWidth;
        }

        /// <summary>
        /// Gets the WorkerW window handle that hosts desktop icons
        /// </summary>
        private IntPtr GetDesktopWorkerW()
        {
            IntPtr progman = FindWindow("Progman", null);
            IntPtr workerw = IntPtr.Zero;

            // Find the WorkerW window that's a sibling of Progman
            IntPtr desktopHandle = FindWindowEx(IntPtr.Zero, IntPtr.Zero, "WorkerW", null);
            while (desktopHandle != IntPtr.Zero)
            {
                IntPtr shellView = FindWindowEx(desktopHandle, IntPtr.Zero, "SHELLDLL_DefView", null);
                if (shellView != IntPtr.Zero)
                {
                    workerw = FindWindowEx(IntPtr.Zero, desktopHandle, "WorkerW", null);
                    if (workerw != IntPtr.Zero)
                    {
                        return workerw;
                    }
                    return desktopHandle;
                }
                desktopHandle = FindWindowEx(IntPtr.Zero, desktopHandle, "WorkerW", null);
            }

            return progman;
        }

        /// <summary>
        /// Gets the width and height of the screen where this window is currently displayed
        /// </summary>
        /// <returns>A tuple containing the screen width and height in pixels</returns>
        private (double Width, double Height) GetCurrentScreenDimensions()
        {
            return (SystemParameters.PrimaryScreenWidth, SystemParameters.PrimaryScreenHeight);
        }

        /// <summary>
        /// Moves the clock window to the desired position
        /// </summary>
        private void TransformToPos()
        {
            (double width, double height) = GetCurrentScreenDimensions();

            foreach (Border b in chartBorders)
            {
                b.Width = width / config.Size;
                b.Height = height / config.Size;
            }

            UpdateLayout();

            switch (config.Position)
            {
                case Config.SystemMonitorPosition.TopLeft:
                    Top = height / config.Margin;
                    Left = width / config.Margin;
                    break;

                case Config.SystemMonitorPosition.TopRight:
                    Top = height / config.Margin;
                    Left = width - (width / config.Margin) - ActualWidth;
                    break;

                case Config.SystemMonitorPosition.BottomLeft:
                    Top = height - (height / config.Margin) - ActualHeight;
                    Left = width / config.Margin;
                    break;

                case Config.SystemMonitorPosition.BottomRight:
                    Top = height - (height / config.Margin) - ActualHeight;
                    Left = width - (width / config.Margin) - ActualWidth;
                    break;
            }
        }
    }
}
